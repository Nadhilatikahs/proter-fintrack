# ===========================================
# FINTRACK - PRODUCTION ENVIRONMENT
# Domain: poyekterapan1.com
# cPanel User: xxxsuzqm
# ===========================================
#
# PRE-UPLOAD CHECKLIST:
# [ ] Generate APP_KEY: php artisan key:generate
# [ ] Set DB_PASSWORD with actual database password
# [ ] Set MAIL_PASSWORD with actual email password
# [ ] Set OPENAI_API_KEY (or leave empty if not using AI)
# [ ] Verify APP_URL matches your domain
# [ ] Verify database credentials match cPanel setup
# [ ] Verify email settings match cPanel email account
# [ ] Ensure APP_DEBUG=false (already set)
#
# ===========================================

APP_NAME=Fintrack
APP_ENV=production
# IMPORTANT: Generate APP_KEY by running: php artisan key:generate
# Then copy the generated key from .env file
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://fintrack.poyekterapan1.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ===========================================
# LOGGING
# ===========================================
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===========================================
# DATABASE - MySQL cPanel
# Buat database via cPanel → MySQL Databases
# Format: cpaneluser_dbname
# ===========================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=xxxsuzqm_fintrack
DB_USERNAME=xxxsuzqm_fintrack
# IMPORTANT: Replace with your actual database password from cPanel
DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ===========================================
# SESSION & CACHE
# ===========================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=fintrack_

# ===========================================
# MAIL (Opsional - untuk notifikasi email)
# Buat email via cPanel → Email Accounts
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=mail.poyekterapan1.com
MAIL_PORT=465
MAIL_USERNAME=noreply@poyekterapan1.com
# IMPORTANT: Replace with your actual email account password from cPanel
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD_HERE
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@poyekterapan1.com"
MAIL_FROM_NAME="Fintrack"

# ===========================================
# VITE
# ===========================================
VITE_APP_NAME="${APP_NAME}"

# ===========================================
# OPENAI API (untuk AI Notification)
# Dapatkan di: https://platform.openai.com/api-keys
# IMPORTANT: Replace with your actual OpenAI API key
# Leave empty if not using AI features: OPENAI_API_KEY=
# ===========================================
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=15

# ===========================================
# FILAMENT
# ===========================================
FILAMENT_FILESYSTEM_DISK=public

